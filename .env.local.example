# Copy this file to .env.local (already git-ignored) and fill in real values.
# Never commit .env.local or paste these values into chat/PRs.

# --- MongoDB Atlas ---
MONGODB_URI=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public (not secret) - read client-side by next-cloudinary's CldImage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- NextAuth (admin login) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Resend (contact form email) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — defaults to Resend's sandbox sender (onboarding@resend.dev). Only
# use a custom address here once its domain is verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# --- Google Analytics 4 (optional) ---
# Public measurement ID. Loads gtag on the public site only (never /admin).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Read-only GA4 Data API for the /admin/analytics page. Grant the service account Viewer on the property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Keep the key on one line with literal \n for newlines.
GA4_PRIVATE_KEY=

# --- Gemini (optional, admin AI artwork assistant) ---
GEMINI_API_KEY=
# Optional: comma-separated models to try in order.
GEMINI_ARTWORK_MODELS=
