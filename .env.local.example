# Copy this file to .env.local (already git-ignored) and fill in real values.
# Never commit .env.local or paste these values into chat/PRs.

# --- MongoDB Atlas ---
MONGODB_URI=

# --- NextAuth (admin login) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Resend (contact form email) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — defaults to Resend's sandbox sender (onboarding@resend.dev). Only
# use a custom address here once its domain is verified in the Resend dashboard.
RESEND_FROM_EMAIL=

# --- Google Analytics 4 (optional) ---
# Public measurement ID. Loads gtag on the public site only (never /admin).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Read-only GA4 Data API for the /admin/analytics page. Grant the service account Viewer on the property.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Keep the key on one line with literal \n for newlines.
GA4_PRIVATE_KEY=

# --- Cloudflare Turnstile (optional, contact form captcha) ---
# Both keys are needed in production. Site key is public; the secret key must stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Gemini (optional, admin AI artwork assistant) ---
GEMINI_API_KEY=
# Optional: comma-separated models to try in order.
GEMINI_ARTWORK_MODELS=

# --- Disaster recovery (optional, see docs/setup/disaster-recovery.md) ---
# Cloudflare R2 (S3-compatible). Keys are server-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Image storage (Cloudflare R2, see docs/setup/media-storage.md) ---
# Private bucket: uploaded originals, used to rebuild variants.
R2_ORIGINALS_BUCKET=
# Public bucket: pre-made WebP variants served to the site.
R2_MEDIA_BUCKET=
# Private bucket: content snapshot (keyed by database name) and encrypted database backups.
R2_BACKUP_BUCKET=

# Public base URL of the media domain, e.g. https://media.example.com
NEXT_PUBLIC_MEDIA_BASE_URL=

# Encrypts database backups. Keep a copy outside this repo and outside the database.
BACKUP_ENCRYPTION_KEY=

# Vercel Cron sends this to /api/cron/content-snapshot. Set the same value in Vercel.
CRON_SECRET=
